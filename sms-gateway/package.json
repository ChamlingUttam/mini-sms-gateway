{
  "name": "mini-sms-gateway-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "prisma generate && tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:check": "prisma generate && tsx src/scripts/check-database.ts"
  },
  "dependencies": {
    "@prisma/adapter-neon": "7.10.1",
    "@prisma/client": "7.10.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.19.0",
    "prisma": "7.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
